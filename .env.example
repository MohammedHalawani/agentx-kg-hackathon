# Copy to .env and fill in. Read by chat/config.py (repo root, shared with backend/).

# --- Neo4j: the graph docs/schema.yaml describes, already loaded --------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Chat thread/message history is stored separately so it never pollutes the domain graph.
CHAT_DATABASE=neo4j

# --- LLM: routed through LiteLLM, same setup as visual-pollution-dedup --------------------
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=

# --- Embeddings: for vector search (scripts/embed_backfill.py) - defaults to local Ollama --
# Pull the model yourself first, e.g.: ollama pull bge-m3
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_DIMENSIONS=1024

# --- Shipment-complaint pipeline (chat/llm/pipeline/): own database, same server/creds -----
SHIPMENT_DATABASE=shipments


