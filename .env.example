# Copy to .env and fill in. Read by chat/config.py (repo root, shared with backend/).

# --- Neo4j: shipments is the active logistics graph --------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# NEO4J_DATABASE is retained for unused legacy tools. Active Explore uses SHIPMENT_DATABASE.
# Chat thread/message history is stored separately so it never pollutes the domain graph.
CHAT_DATABASE=neo4j

# --- LLM: paired V1 evidence favors this model on the tested Ollama Cloud endpoint --------
LLM_MODEL=openai/gpt-oss:120b
LLM_API_KEY=
LLM_API_BASE=https://ollama.com/v1
# Alternatively set OLLAMA_API_KEY locally; never put credentials in frontend or Git.

# --- Embeddings: chat/scripts/embed_backfill_shipments.py; pending outcomes excluded ------
# Pull the model yourself first, e.g.: ollama pull bge-m3
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_DIMENSIONS=1024

# --- Shipment-complaint pipeline (chat/llm/pipeline/): own database, same server/creds -----
SHIPMENT_DATABASE=shipments

# --- V3 concurrency (operations.claims, operations.provider_gate); these are the shipped defaults ------
# Cases investigated at once: 1 or 2. Anything else is read as 1. 1 is the fallback.
SUHAIL_INVESTIGATION_WORKERS=1
# A claim not renewed for this many wall-clock seconds has expired (1 to 3600).
SUHAIL_CLAIM_LEASE_SECONDS=180
# How often the owner renews its claim; never more than a third of the lease.
SUHAIL_CLAIM_HEARTBEAT_SECONDS=15
# Provider calls this process may have open at once: 1 or 2. Keep 1 until a higher capacity of the
# provider account is verified. The limit covers this process only, not other clients of the account.
SUHAIL_PROVIDER_MAX_INFLIGHT=1
# V3.2 production inference: durable aggregate limits; restarting does not reset them.
SUHAIL_MAX_OUTPUT_TOKENS=2048
SUHAIL_MAX_INPUT_BYTES=65536
SUHAIL_INFERENCE_MAX_CALLS=100
SUHAIL_INFERENCE_MAX_TOKENS=1000000
SUHAIL_INFERENCE_MAX_USD=0.50
# REQUIRED trusted upper-bound tariffs in USD per million tokens. Empty blocks inference.
# Configure from your own provider agreement before any separately authorized paid use.
SUHAIL_INPUT_USD_PER_MILLION=
SUHAIL_OUTPUT_USD_PER_MILLION=
# Default ledger: .runtime/inference-budget.json (ignored); share its absolute path across processes.
# SUHAIL_INFERENCE_LEDGER=
# Explicit synthetic response transport only; no external operational requests.
SUHAIL_SYNTHETIC_ACTION_RESPONSES=0
# The V3 backend is started with scripts/v3_backend.ps1, which sets the model, database, state root and
# these four settings for its own process; it does not rely on the values in this file.


