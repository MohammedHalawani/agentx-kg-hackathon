# Copy to .env and fill in. Read by chat/config.py (repo root, shared with backend/).

# --- Neo4j: shipments is the active logistics graph --------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# NEO4J_DATABASE is retained for unused legacy tools. Active Explore uses SHIPMENT_DATABASE.
# Chat thread/message history is stored separately so it never pollutes the domain graph.
CHAT_DATABASE=neo4j

# --- LLM: paired V1 evidence favors this model on the tested Ollama Cloud endpoint --------
LLM_MODEL=openai/gpt-oss:120b
LLM_API_KEY=
LLM_API_BASE=https://ollama.com/v1
# Alternatively set OLLAMA_API_KEY locally; never put credentials in frontend or Git.

# --- Embeddings: chat/scripts/embed_backfill_shipments.py; pending outcomes excluded ------
# Pull the model yourself first, e.g.: ollama pull bge-m3
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_DIMENSIONS=1024

# --- Shipment-complaint pipeline (chat/llm/pipeline/): own database, same server/creds -----
SHIPMENT_DATABASE=shipments


