# Copy to .env and fill in. Read by chat/config.py (repo root, shared with backend/).

# --- Neo4j: the graph docs/schema.yaml describes, already loaded --------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Chat thread/message history is stored separately so it never pollutes the domain graph.
CHAT_DATABASE=neo4j

# --- LLM: routed through LiteLLM, same setup as visual-pollution-dedup --------------------
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=

# --- Map data: parsed directly from CSV, never ingested into Neo4j (sensitive - fill in later)
# category CSV columns: incident_category, category_id
CATEGORY_CSV=
# incidents CSV columns: category_id, incident_id, municipality_date, lat, lng, source_id
INCIDENTS_CSV=
# track-status CSV columns: data_entry_id, track_id, entity_id, entry_action, status, date,
# Notes, picture_1, picture_2, lat, lng, municipality, source_id, track_location
TRACK_STATUS_CSV=
# folder picture_1/picture_2 paths resolve against; served read-only at /photos/<file>
PHOTOS_DIR=
