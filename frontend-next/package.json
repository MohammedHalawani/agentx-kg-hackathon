{
  "name": "suhail-frontend-next",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dev:lab": "vite --mode lab --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "build:lab": "tsc -b && vite build --mode lab",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:lab": "playwright test --config playwright.lab.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5191 --strictPort",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/noto-sans-arabic": "^5.2.8",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-table": "8.21.3",
    "@xyflow/react": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.14.3",
    "react-router-dom": "^7.9.3",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
