// ======================================================================
// CONSTRAINTS / INDEXES (recommended for MATCH performance below)
// ======================================================================
CREATE INDEX IF NOT EXISTS FOR (n:Order) ON (n.order_id);
CREATE INDEX IF NOT EXISTS FOR (n:Shipment) ON (n.shipment_id);
CREATE INDEX IF NOT EXISTS FOR (n:Customer) ON (n.customer_id);
CREATE INDEX IF NOT EXISTS FOR (n:Address) ON (n.address_id);
CREATE INDEX IF NOT EXISTS FOR (n:Courier) ON (n.courier_id);
CREATE INDEX IF NOT EXISTS FOR (n:Policy) ON (n.policy_id);
CREATE INDEX IF NOT EXISTS FOR (n:Event) ON (n.event_id);
CREATE INDEX IF NOT EXISTS FOR (n:FailureReason) ON (n.failure_id);
CREATE INDEX IF NOT EXISTS FOR (n:Resolution) ON (n.resolution_id);
CREATE INDEX IF NOT EXISTS FOR (n:Outcome) ON (n.outcome_id);

